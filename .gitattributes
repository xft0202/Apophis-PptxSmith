# 统一行尾为 LF，避免 Windows/Linux 贡献者之间的无意义 diff
# （ADR-0007：服务端唯一支持 Linux Docker；仓库内文本必须跨平台一致）
* text=auto eol=lf

# 显式声明文本类型，防止中文 Markdown 被误判为二进制
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# 二进制：禁止 diff 与行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.ttf  binary
*.otf  binary
*.ttc  binary
*.zip  binary
